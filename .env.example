# Crossmint API
CROSSMINT_API_KEY="your_crossmint_api_key"
CROSSMINT_BASE_URL="https://staging.crossmint.com/api/2025-06-09"

# Bridge account seed (deterministic keypair derivation, no private key storage needed)
# Use: deno task generate-keys --seed "your-seed" to preview the G... public key
BRIDGE_SEED="your-bridge-seed"

# MoneyGram / Stellar Anchor
MONEYGRAM_DOMAIN="extstellar.moneygram.com"
USDC_ISSUER="GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5"

# Client domain (your TOML server domain)
CLIENT_DOMAIN="your-toml-server-domain.vercel.app"
# Seed for the client domain signing keypair (public key goes in your stellar.toml SIGNING_KEY)
CLIENT_SIGNING_SEED="your-client-signing-seed"

# Stellar network
STELLAR_NETWORK="testnet"
