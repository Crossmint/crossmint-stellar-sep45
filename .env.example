# Crossmint API
CROSSMINT_API_KEY="your_crossmint_api_key"
CROSSMINT_BASE_URL="https://staging.crossmint.com/api/2025-06-09"

# Signer seed (deterministic keypair for external-wallet signer)
SIGNER_SEED="your-signer-seed"

# Anchor domain (default: testanchor.stellar.org)
ANCHOR_DOMAIN="testanchor.stellar.org"

# USDC issuer on Stellar
USDC_ISSUER="GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5"

# USDC SAC contract ID (Soroban Asset Contract)
# Testnet: CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
# Mainnet: CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75
USDC_CONTRACT_ID="CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA"

# Stellar network
STELLAR_NETWORK="testnet"

# Optional: SEP-45 client_domain attribution.
# CLIENT_DOMAIN is the domain hosting your stellar.toml (see toml-server/).
# CLIENT_DOMAIN_SIGNER_SEED derives the keypair whose public key is that TOML's
# SIGNING_KEY; it signs the extra client_domain challenge entry. Leave unset to skip.
# CLIENT_DOMAIN="your-wallet-domain.com"
# CLIENT_DOMAIN_SIGNER_SEED="your-client-domain-seed"
