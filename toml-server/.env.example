# Public signing key (G...) published in the TOML. Anchors read this to verify
# your domain for SEP-10 / SEP-45 client_domain attribution. Your backend keeps
# the matching SECRET key (used to sign the client_domain challenge entry).
TOML_SIGNING_KEY=""

# Network passphrase (default: testnet).
# Mainnet: "Public Global Stellar Network ; September 2015"
TOML_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Optional: comma-separated accounts for the ACCOUNTS field.
TOML_ACCOUNTS=""

# Optional: organization name for the [DOCUMENTATION] section.
TOML_ORG_NAME=""
