    { "key": "CLIENT_DOMAIN", "value": "" },
    { "key": "CLIENT_DOMAIN_SIGNER_SEED", "value": "" },
    { "key": "WALLET_IDEMPOTENCY_KEY", "value": "" },
    { "key": "crossmintWalletAddress", "value": "" },
